# --- Database ---
DATABASE_URL=postgres://cpd:cpd@localhost:5433/cpd
TEST_DATABASE_URL=postgres://cpd:cpd@localhost:5433/cpd_test

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_SESSION_SECRET=<generate-with-openssl-rand-base64-32>
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Executor ---
EXECUTOR_URL=http://localhost:4100
EXECUTOR_PORT=4100
# Docker sandbox enabled; falls back to local sandbox if unavailable
EXECUTOR_USE_DOCKER=true
# Set to "runsc" for gVisor sandboxing (requires runsc installed on host)
# Leave empty for default runc
EXECUTOR_DOCKER_RUNTIME=
EXECUTOR_DOCKER_IMAGE_CPP=gcc:latest
EXECUTOR_DOCKER_IMAGE_PYTHON=python:3.12-alpine
EXECUTOR_DEFAULT_TIMEOUT_MS=5000
EXECUTOR_MAX_TIMEOUT_MS=30000
EXECUTOR_DEFAULT_MEMORY_MB=256

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000
REMINDER_SWEEP_INTERVAL_MIN=5
DAILY_GENERATION_HOUR=0   # hour (UTC) to start generating the day's sessions
MISSED_PROCESSING_INTERVAL_MIN=15
DECAY_SWEEP_INTERVAL_MIN=60

# --- Notifications ---
NOTIFICATION_MAX_PER_DAY=12
NOTIFICATION_MAX_REMINDERS_PER_DAY=6
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Code Mentor <mentor@example.com>"

# --- App ---
APP_NAME=Code Mentor
APP_BASE_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info